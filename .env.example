# ==============================================
#   ShortsAI Agent — Environment Variables
# ==============================================

# ── Server ────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── OpenAI ────────────────────────────────────
# Used for: script generation, hooks, scene breakdowns, image prompts
OPENAI_API_KEY=sk-...

# ── ElevenLabs ────────────────────────────────
# Used for: AI voiceover narration
ELEVENLABS_API_KEY=...
# Default voice ID (Rachel = 21m00Tcm4TlvDq8ikWAM, Adam = pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Replicate ─────────────────────────────────
# Used for: video clip generation (Stable Video Diffusion, etc.)
REPLICATE_API_TOKEN=r8_...

# ── Stability AI ──────────────────────────────
# Used for: scene image generation (alternative to DALL·E)
STABILITY_API_KEY=sk-...

# ── Image Generation Mode ─────────────────────
# Options: "dalle" | "stability"
IMAGE_PROVIDER=dalle

# ── Video Generation Mode ─────────────────────
# Options: "replicate" | "mock"
VIDEO_PROVIDER=replicate

# ── Storage ───────────────────────────────────
# Local path for generated files
OUTPUT_DIR=./output

# ── CORS ──────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
